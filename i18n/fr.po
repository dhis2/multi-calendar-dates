msgid "Couldn't find a monthly period for weekly period id \"{{periodId}}\""
msgstr ""
"Impossible de trouver une période mensuelle pour l'identifiant de la période"
" hebdomadaire \"{{periodId}}\""

msgid "Couldn't find a weekly period for weekly period id \"{{periodId}}\""
msgstr ""
"Impossible de trouver une période hebdomadaire pour l'identifiant de la "
"période hebdomadaire \"{{periodId}}\""

msgid "Couldn't handle unknown period id \"{{periodId}}\""
msgstr ""
"Impossible de traiter l'identifiant d'une période inconnue \"{{periodId}}\""

msgid "Could not find a period type for period id \"{{periodId}}\""
msgstr ""
"Impossible de trouver un type de période pour l'identifiant de période "
"\"{{periodId}}\""

msgid "Could not determine a period type for period id \"{{periodId}}\""
msgstr ""
"Impossible de déterminer un type de période pour l'identifiant de période "
"\"{{periodId}}\""

msgid "Couldn't find a period type for weekly period id \"{{periodId}}\""
msgstr ""
"Impossible de trouver un type de période pour l'identifiant de la période "
"hebdomadaire \"{{periodId}}\""

msgid "Bi-Week"
msgstr "Bi-hebdomadaire"

msgid "Week"
msgstr "Semaine"

msgid "Date string is invalid, received \"{{dateString}}\""
msgstr "Chaîne de date non valide, chaîne reçue : \"{{dateString}}\"."

msgid ""
"Date string format does not match the specified format. Expected {{format}} "
"but got {{detectedFormat}}."
msgstr ""
"Le format de la chaîne de date ne correspond pas au format spécifié. Le "
"format attendu est {{format}} mais le format obtenu est {{detectedFormat}}."

msgid "Unrecognized date, received \"{{date}}\""
msgstr "Date non reconnue, date reçue : \"{{date}}\"."

msgid "Year {{year}} is out of range."
msgstr "L'année {{year}} est hors de la fourchette."

msgid "Month {{month}} is out of range | 1 <= {{month}} <= 12."
msgstr "Le mois {{month}} est hors de la fourchette | 1 <= {{month}} <= 12."

msgid "Day {{day}} is out of range | 1 <= {{day}} <= {{daysInMonth}}."
msgstr ""
"Le jour {{day}} est hors de la fourchette | 1 <= {{day}} <= {{daysInMonth}}."

msgid "Date is not given"
msgstr "La date n'est pas indiquée"

msgid ""
"Date {{dateString}} is less than the minimum allowed date {{minDateString}}."
msgstr ""
"La date {{dateString}} est inférieure à la date minimale autorisée "
"{{minDateString}}."

msgid ""
"Date {{dateString}} is greater than the maximum allowed date "
"{{maxDateString}}."
msgstr ""
"La date {{dateString}} est supérieure à la date maximale autorisée "
"{{maxDateString}}."
